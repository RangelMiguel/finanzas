# ── Database (PostgreSQL required for Vercel / production) ──────────────────
# Local: Docker, local Postgres, or a free Neon project
# Vercel: paste from Neon / Vercel Postgres / Supabase
#
# Neon example (pooled for runtime, direct for migrations):
# DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
#
# If you only have one URL (local Postgres), set both to the same value:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/misfinanzas?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/misfinanzas?schema=public"

# ── Auth (required) ─────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-min-16-chars"

# Shared with Meat so the Apps menu can sign you in (or create the account).
# Generate once and paste the same value in both apps.
# SUITE_SSO_SECRET="change-me-to-a-long-random-string-min-16-chars"
# NEXT_PUBLIC_MEAT_URL="https://meat.example.com"

# ── Optional: LLM extraction for receipts & bank statements ─────────────────
# Prefer Grok (xAI). If unset, rule-based parsers are used.
# XAI_API_KEY=
# GROK_API_KEY=          # alias for XAI_API_KEY
# XAI_MODEL=grok-4.5
# XAI_BASE_URL=https://api.x.ai/v1

# Or Gemini:
# GEMINI_API_KEY=
# GOOGLE_API_KEY=        # alias
# GEMINI_MODEL=gemini-2.0-flash

# auto | grok | gemini
# LLM_PROVIDER=auto
# LLM_MODEL=


# ── WebAuthn / passkeys (usually auto-detected from request host) ───────────
# WEBAUTHN_RP_ID=your-app.vercel.app
# WEBAUTHN_ORIGIN=https://your-app.vercel.app
# WEBAUTHN_RP_NAME=MisFinanzas Familiar

# ── Web Push (system notification tray on Android / installed PWA) ──────────
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.com
