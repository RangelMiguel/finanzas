generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) URL for migrations. Optional on local Postgres.
  // Neon/Supabase: use the non-pooled connection string here.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Null = passkey-only account (password auth disabled)
  passwordHash String?
  displayName  String
  locale       String   @default("es")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships          Membership[]
  invitesCreated       Invite[]            @relation("InviteCreator")
  transactionsCreated  Transaction[]       @relation("TxnCreatedBy")
  transactionsSpent    Transaction[]       @relation("TxnSpentBy")
  preferences          UserPreference?
  activityEvents       ActivityEvent[]
  householdsCreated    Household[]         @relation("HouseholdCreator")
  allowances           Allowance[]
  personalAllocations  PersonalAllocation[]
  personalIncomes      PersonalIncome[]
  personalBudgets      PersonalBudget[]
  personalExpenses     PersonalExpense[]
  webauthnCredentials  WebAuthnCredential[]
  securityAlerts       SecurityAlert[]
  alertDismissals      SecurityAlertDismissal[]
  pushSubscriptions    PushSubscription[]
  goalsCreated         Goal[]              @relation("GoalCreator")
  goalReserves         GoalReserve[]
  retirementPlans      RetirementPlan[]
  mutationIdempotency  MutationIdempotency[]
  personalAccounts     Account[]             @relation("PersonalAccountOwner")
  budgetPeriodCloses   BudgetPeriodClose[]
}

/// Prevents duplicate creates when offline outbox retries a POST.
model MutationIdempotency {
  id           String   @id @default(cuid())
  /// Scoped per user: client Idempotency-Key / clientMutationId
  key          String
  userId       String
  path         String
  /// JSON string of successful response body
  responseJson String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
}

model Household {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("MXN")
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator          User?              @relation("HouseholdCreator", fields: [createdBy], references: [id])
  memberships      Membership[]
  invites          Invite[]
  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  budgets          Budget[]
  budgetDefaults   BudgetDefault[]
  budgetPeriodCloses BudgetPeriodClose[]
  creditCards      CreditCard[]
  installmentPlans InstallmentPlan[]
  recurringIncomes RecurringIncome[]
  recurringExpenses RecurringExpense[]
  debts            Debt[]
  debtPayments     DebtPayment[]
  activityEvents   ActivityEvent[]
  preferences      UserPreference[]
  allowances      Allowance[]
  personalAllocations PersonalAllocation[]
  personalIncomes     PersonalIncome[]
  personalBudgets     PersonalBudget[]
  personalExpenses    PersonalExpense[]
  securityAlerts      SecurityAlert[]
  goals              Goal[]
  goalReserves       GoalReserve[]
  retirementPlans    RetirementPlan[]
  visibilityTemplates VisibilityTemplate[]
  installedModules   HouseholdModule[]
  propertyItems      PropertyItem[]
}

/// Add-on modules installed for this household (marketplace).
model HouseholdModule {
  id           String   @id @default(cuid())
  householdId  String
  moduleId     String
  installedAt  DateTime @default(now())
  installedById String?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, moduleId])
  @@index([householdId])
}

/// Valuables: assets (activos) and liabilities (pasivos) for the Properties module.
model PropertyItem {
  id          String   @id @default(cuid())
  householdId String
  name        String
  /// asset | liability
  kind        String
  /// home | vehicle | land | jewelry | electronics | furniture | mortgage | loan | other
  category    String   @default("other")
  valueCents  Int      @default(0)
  /// none | appreciate | depreciate
  valueChange String   @default("none")
  annualRatePercent Float @default(0)
  /// compound | straight
  method      String   @default("compound")
  usefulLifeYears Float?
  salvageCents Int     @default(0)
  notes       String?
  acquiredOn  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  improvements PropertyImprovement[]

  @@index([householdId, kind])
}

/// Money invested in a property (remodel, repair) and its estimated value impact.
model PropertyImprovement {
  id              String   @id @default(cuid())
  householdId     String
  propertyId      String
  description     String
  costCents       Int
  /// improve | depreciate
  effect          String   @default("improve")
  /// Share of cost that typically hits market value (e.g. 70 = 70%).
  recoveryPercent Float    @default(70)
  doneOn          String?
  createdAt       DateTime @default(now())

  property PropertyItem @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([householdId])
}

/// Reusable security / visibility policies for members and invites
model VisibilityTemplate {
  id          String   @id @default(cuid())
  householdId String
  name        String
  /// JSON MemberVisibility
  visibility  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Membership {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  role        String   // owner | admin | member | viewer
  /// Per-member visibility / security policy (JSON MemberVisibility)
  visibility  String   @default("{}")
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  householdId String
  email       String
  role        String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String?
  /// Pre-join security policy (JSON MemberVisibility) — applied when invite is accepted
  visibility  String    @default("{}")
  createdAt   DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("InviteCreator", fields: [createdById], references: [id])

  @@index([email])
  @@index([householdId])
}

model UserPreference {
  id                   String    @id @default(cuid())
  userId               String    @unique
  householdId          String?
  lastVisitAt          DateTime?
  theme                String    @default("midnight")
  /// Last time user opened / dismissed the security notification feed
  securityAlertsSeenAt DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household? @relation(fields: [householdId], references: [id])
}

model Account {
  id               String   @id @default(cuid())
  householdId      String
  name             String
  type             String   // cash | checking | debit | savings | personal | other
  icon             String   @default("🏦")
  initialBalanceCents Int   @default(0)
  /// If set, this is a private personal account for that household member
  ownerUserId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  household          Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner              User?             @relation("PersonalAccountOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  transactionsFrom   Transaction[]     @relation("TxnAccount")
  transactionsTo     Transaction[]     @relation("TxnToAccount")
  recurringIncomes   RecurringIncome[]
  recurringExpenses  RecurringExpense[]
  debtPayments       DebtPayment[]
  goalReserves       GoalReserve[]
  fundings           TransactionFunding[]

  @@index([householdId])
  @@index([householdId, ownerUserId])
  @@unique([householdId, ownerUserId])
}

model Category {
  id          String   @id @default(cuid())
  householdId String
  name        String
  type        String   // income | expense
  icon        String   @default("📦")
  color       String   @default("#6366f1")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  household        Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  budgets          Budget[]
  budgetDefaults   BudgetDefault[]
  installmentPlans InstallmentPlan[]
  recurringIncomes RecurringIncome[]
  recurringExpenses RecurringExpense[]
  allowances       Allowance[]
  goalReserves     GoalReserve[]

  @@index([householdId])
}

model Transaction {
  id                String    @id @default(cuid())
  householdId       String
  date              String    // YYYY-MM-DD
  amountCents       Int
  description       String
  type              String    // income | expense | transfer
  categoryId        String?
  /// Legacy / primary bank account (kept in sync with fundings for single-source)
  accountId         String?
  toAccountId       String?
  /// Legacy / primary credit card (kept in sync with fundings for single-source)
  creditCardId      String?
  installmentPlanId String?
  isAutoGenerated   Boolean   @default(false)
  /// For type=cc_payment: statement due date this payment is applied to first
  ccCycleDue        String?
  createdById       String?
  spentById         String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  household       Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category        Category?            @relation(fields: [categoryId], references: [id])
  account         Account?             @relation("TxnAccount", fields: [accountId], references: [id])
  toAccount       Account?             @relation("TxnToAccount", fields: [toAccountId], references: [id])
  creditCard      CreditCard?          @relation(fields: [creditCardId], references: [id])
  installmentPlan InstallmentPlan?     @relation(fields: [installmentPlanId], references: [id])
  createdBy       User?                @relation("TxnCreatedBy", fields: [createdById], references: [id])
  spentBy         User?                @relation("TxnSpentBy", fields: [spentById], references: [id])
  /// How this expense was paid (one or more bank accounts and/or credit cards)
  fundings        TransactionFunding[]

  @@index([householdId, date])
  @@index([householdId, type])
  @@index([accountId])
  @@index([creditCardId])
}

/// Split payment sources for a transaction (accounts + credit cards in one list).
/// Each row is either an account OR a credit card (not both).
model TransactionFunding {
  id            String  @id @default(cuid())
  transactionId String
  amountCents   Int
  accountId     String?
  creditCardId  String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCard  CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([accountId])
  @@index([creditCardId])
}

model Budget {
  id           String   @id @default(cuid())
  householdId  String
  categoryId   String
  amountCents  Int
  /// Leftover from the previous closed period. Does NOT raise amountCents.
  emergencyCents Int    @default(0)
  /// Budget period: YYYY-MM-1 (days 1-15) or YYYY-MM-2 (days 16-end)
  period       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, period])
  @@index([householdId, period])
}

/// Snapshot of a closed half-month and where leftover went.
model BudgetPeriodClose {
  id          String   @id @default(cuid())
  householdId String
  period      String
  toPeriod    String
  /// JSON: [{ categoryId, remainingCents, allocations: [{ kind, amountCents, categoryId?, goalId?, reserveId? }] }]
  /// kind: emergency | goal | spent. Legacy rows without allocations = all emergency.
  carryovers  String
  closedById  String?
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  closedBy  User?     @relation(fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([householdId, period])
  @@index([householdId])
}

/// Template applied to months that have no explicit budget rows
model BudgetDefault {
  id          String   @id @default(cuid())
  householdId String
  categoryId  String
  amountCents Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId])
  @@index([householdId])
}

model CreditCard {
  id          String   @id @default(cuid())
  householdId String
  name        String
  lastFour    String   @default("")
  cutoffDay   Int      @default(1)
  graceDays   Int      @default(20)
  color       String   @default("#8b5cf6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household        Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  installmentPlans InstallmentPlan[]
  fundings         TransactionFunding[]
  recurringExpenses RecurringExpense[]

  @@index([householdId])
}

model InstallmentPlan {
  id              String   @id @default(cuid())
  householdId     String
  description     String
  totalAmountCents Int
  months          Int
  monthlyAmountCents Int
  creditCardId    String?
  categoryId      String?
  startDate       String
  /// JSON array of charge dates (YYYY-MM-DD) removed from the schedule (single-payment deletes)
  removedDates    String   @default("[]")
  createdAt       DateTime @default(now())

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  creditCard   CreditCard?   @relation(fields: [creditCardId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@index([householdId])
}

model RecurringIncome {
  id          String   @id @default(cuid())
  householdId String
  description String
  amountCents Int
  categoryId  String?
  accountId   String?
  dayOfMonth  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])
  account   Account?  @relation(fields: [accountId], references: [id])

  @@index([householdId])
}

model RecurringExpense {
  id           String   @id @default(cuid())
  householdId  String
  description  String
  amountCents  Int
  categoryId   String?
  accountId    String?
  creditCardId String?
  dayOfMonth   Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household  Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id])
  account    Account?    @relation(fields: [accountId], references: [id])
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id])

  @@index([householdId])
}

model Debt {
  id                 String   @id @default(cuid())
  householdId        String
  name               String
  principalCents     Int
  annualRatePercent  Float    @default(0)
  monthlyPaymentCents Int     @default(0)
  paymentDay         Int      @default(1)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  payments  DebtPayment[]

  @@index([householdId])
}

model DebtPayment {
  id               String   @id @default(cuid())
  householdId      String
  debtId           String
  date             String
  capitalCents     Int
  interestCents    Int      @default(0)
  accountId        String?
  notes            String?
  createdAt        DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  debt      Debt      @relation(fields: [debtId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [accountId], references: [id])

  @@index([householdId])
  @@index([debtId])
}

model ActivityEvent {
  id          String   @id @default(cuid())
  householdId String
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  summary     String
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([householdId, createdAt])
}

model Allowance {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  name        String
  amountCents Int
  period      String   @default("monthly") // monthly | weekly
  categoryId  String?
  enforce     Boolean  @default(true)
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])

  @@index([householdId])
  @@index([userId])
  @@index([householdId, userId])
}



/// Admin-defined personal allocation (not household cash). Pool for personal budgets.
/// amountCents is applied to each half-month (quincena).
model PersonalAllocation {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  name        String   @default("Asignación personal")
  amountCents Int
  /// Frequency label: bimonthly (per quincena) — amount applies each half-month
  period      String   @default("bimonthly")
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId, userId])
}

/// Side-job / personal income (does not affect household accounts)
model PersonalIncome {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  description String
  amountCents Int
  date        String
  /// Budget period: YYYY-MM-1 (days 1-15) or YYYY-MM-2 (days 16-end)
  period      String
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId, userId, period])
}

/// Individual budget envelopes funded by allocation + personal income
model PersonalBudget {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  name        String
  amountCents Int
  /// Budget period: YYYY-MM-1 | YYYY-MM-2
  period      String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  PersonalExpense[]

  @@index([householdId, userId, period])
}

/// Personal spending against individual budgets (not household ledger)
model PersonalExpense {
  id               String   @id @default(cuid())
  householdId      String
  userId           String
  personalBudgetId String?
  description      String
  amountCents      Int
  date             String
  /// Budget period: YYYY-MM-1 | YYYY-MM-2
  period           String
  createdAt        DateTime @default(now())

  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalBudget PersonalBudget? @relation(fields: [personalBudgetId], references: [id], onDelete: SetNull)

  @@index([householdId, userId, period])
  @@index([personalBudgetId])
}

/// Passkeys / security keys (WebAuthn) — Face ID, Touch ID, Android biometrics, USB/NFC keys
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  /// Base64URL credential id
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String?
  backedUp     Boolean   @default(false)
  /// JSON string array of AuthenticatorTransport
  transports   String?
  nickname     String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Short-lived WebAuthn challenges (registration / authentication)
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  /// registration | authentication
  type      String
  challenge String   @unique
  userId    String?
  email     String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
  @@index([email])
}

/// Sliding-window rate limit counters (works on serverless without Redis)
model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

/// Security monitoring events (shown to household owner + emailed in near real-time)
model SecurityAlert {
  id          String    @id @default(cuid())
  householdId String?
  userId      String?
  /// e.g. login_success | login_failed | register | wipe | passkey_added | rate_limited
  type        String
  /// info | warning | critical
  severity    String    @default("info")
  summary     String
  detail      String?
  ip          String?
  userAgent   String?
  emailedAt   DateTime?
  createdAt   DateTime  @default(now())

  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  dismissals  SecurityAlertDismissal[]

  @@index([householdId, createdAt])
  @@index([createdAt])
  @@index([type])
}

/// Per-user dismissals so each member can clear their tray without deleting household audit log
model SecurityAlertDismissal {
  id        String   @id @default(cuid())
  alertId   String
  userId    String
  createdAt DateTime @default(now())

  alert SecurityAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId])
  @@index([userId])
}

/// Web Push subscription for system notification tray (Android/iOS/desktop)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Savings goal (meta) for the household
model Goal {
  id                String   @id @default(cuid())
  householdId       String
  name              String
  targetAmountCents Int
  icon              String   @default("🎯")
  notes             String?
  /// active | completed | cancelled
  status            String   @default("active")
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("GoalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reserves  GoalReserve[]

  @@index([householdId, status])
}

/// Money reserved toward a goal for a given quincena.
/// `account` source: cash reserved from an account (linked expense txn).
/// `budget` source: leftover taken from a category envelope mid-period — no cash movement.
/// `budget_close` source: leftover assigned at period close — no cash movement.
model GoalReserve {
  id            String   @id @default(cuid())
  householdId   String
  goalId        String
  accountId     String?
  /// Category envelope when source is `budget` (mid-period deduction).
  categoryId    String?
  /// account | budget | budget_close
  source        String   @default("account")
  amountCents   Int
  /// Budget period: YYYY-MM-1 | YYYY-MM-2
  period        String
  date          String
  notes         String?
  createdById   String?
  /// Linked expense transaction that reduced the account balance
  transactionId String?
  createdAt     DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([householdId, period])
  @@index([goalId])
  @@index([accountId])
  @@index([categoryId])
  @@index([householdId, period, source])
}


/// Per-user retirement projection parameters (within a household)
model RetirementPlan {
  id        String   @id @default(cuid())
  householdId String
  userId    String
  /// Display name for this plan
  name      String   @default("Mi retiro")

  currentAge          Int      @default(35)
  retirementAge       Int      @default(65)
  lifeExpectancyAge   Int      @default(90)

  /// Desired annual spending in retirement, in TODAY's currency units (cents/year)
  desiredAnnualIncomeCents Int @default(36000000)
  /// Current gross annual income (for replacement-ratio suggestions), cents
  currentAnnualIncomeCents Int @default(0)
  /// Target replacement ratio 0-100 (informational / helper)
  replacementPercent  Int      @default(70)

  /// Override nest egg; if null, use sum of household accounts (+ optional goals)
  currentSavingsCents Int?
  includeAccountBalances Boolean @default(true)
  includeGoalReserves    Boolean @default(true)

  /// Monthly contribution toward retirement, cents
  monthlyContributionCents Int @default(0)
  /// Expected contribution growth % per year (raises, etc.)
  contributionGrowthPercent Float @default(0)

  /// Expected nominal annual return % while working
  returnPrePercent    Float    @default(7)
  /// Expected nominal annual return % in retirement
  returnPostPercent   Float    @default(4)
  /// Expected inflation % per year
  inflationPercent    Float    @default(3.5)
  /// Safe withdrawal rate % (e.g. 4) — used as alternate nest-egg estimate
  withdrawalRatePercent Float  @default(4)

  /// Expected annual pension / IMSS / social security in TODAY's pesos (cents)
  pensionAnnualCents  Int      @default(0)
  /// Other guaranteed annual income in retirement (today's pesos, cents)
  otherIncomeAnnualCents Int   @default(0)

  /// Optional effective tax drag on portfolio returns (0-100)
  taxDragPercent      Float    @default(0)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

/// Latest fetched reference rates (refreshed once per calendar month).
model MarketRateSnapshot {
  id         String   @id @default("global")
  /// YYYY-MM in America/Mexico_City
  monthKey   String
  fetchedAt  DateTime
  quotesJson String
  statusJson String   @default("{}")
}
